{
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "name": "Hang On",
  "version": "0.1.0",
  "author": "Aishwarya Agarwal",
  "homepage_url": "https://github.com/aishagarwal/hang-on",
  "description": "Asks for confirmation before closing a tab while a video call is in progress, on sites you choose (e.g. Google Meet).",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Hang On settings" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
